# ===== Turso（libSQL）=====
# 在 Turso CLI 里这样取：
#   turso db create dietdiary
#   turso db show dietdiary --url          -> 填到 TURSO_DATABASE_URL
#   turso db tokens create dietdiary       -> 填到 TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://<你的库名>-<你的用户名>.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=<把你的 token 填在这里，不要提交进仓库>

# 本地开发不想连 Turso 时，把上面两行注释掉，会自动退化成
# 本地文件数据库 ./local.db（仅本机可用，Render 上请务必用 Turso）
# TURSO_DATABASE_URL=file:./local.db

# ===== 服务 =====
# Render 会自己注入 PORT，本地默认 3000
PORT=3000

# ===== 拍照识别（阿里云百炼 / DashScope）=====
# 用户在 App 里拍一张饭照，服务端拿去问视觉模型「这是啥、多少克」。
# Key 只放这里，**绝对不要**写进 app/assets/www 里的任何文件 ——
# 那个目录会被打进 APK，反编译一层就能看到，几百块额度几分钟能被刷光。
#
# Key 在百炼控制台「API-KEY 管理」创建：https://bailian.console.aliyun.com/
# ⚠️ Key 是分地域的：北京节点的地址必须配北京创建的 Key，否则一律 401 invalid_api_key。
# 不填 = 识别接口返回 503，App 里那个按钮点了会提示「服务端没配」，其它功能不受影响。
DASHSCOPE_API_KEY=

# 接口地址。不填就用官方通用地址（两种都通）：
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 控制台「模型调用」页给的专属地址（带 WorkspaceId，2026 年新房型）也可以直接填：
# BAILIAN_BASE_URL=https://<你的WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 用哪个视觉模型。想再省钱：qwen3-vl-flash；认不准大桌菜：qwen3-vl-plus / qwen-vl-max。
# 这个模型名不可用时会自动顺着内置候选表往下试（见 src/vision.js）。
VISION_MODEL=qwen3-vl-plus

# 每人每天最多识别几次。默认 5（一天三顿 + 两次加餐）。
# 计数存在库里的 recognize_usage 表，按中国时间的零点重置，重启/多实例都不会丢。
RECOGNIZE_DAILY_LIMIT=5
# 「每天」按哪个时区分界。Render 跑在 UTC，留 8 就是北京时间零点清零。
RECOGNIZE_TZ_OFFSET_HOURS=8
# 单张图片上限（字节）。App 会先压到 896px，正常一张 100–200 KB
RECOGNIZE_MAX_IMAGE_BYTES=4194304
# 调模型超时（毫秒）
RECOGNIZE_TIMEOUT_MS=45000
# 1 = 不真的调模型，直接返回一组假数据，用来离线联调前端 / 跑截图
# RECOGNIZE_MOCK=1

# ===== 鉴权 =====
# 本服务不用 JWT 库：登录 token 是 crypto.randomBytes 随机串，存 sessions 表。
# JWT_SECRET 只作为 pepper 掺进 token 派生（见 src/auth.js 的 PEPPER），
# 「换掉它 = 所有旧 token 立即失效」，方便强制下线。请务必改成随机长字符串。
# 生成方法： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（天），过期后 token 失效，需要重新登录
SESSION_TTL_DAYS=90

# ===== 更新检查接口 GET /api/version 用 =====
# App 启动时会请求它，不需要鉴权。
#
# 这几个值必须与「你真正上传的那个 APK」一致，否则：
#   填得比客户端低  -> 永远不提示更新
#   填得高但 URL 404 -> 用户点了「下载并安装」必然白下
# 客户端当前版本是 versionCode=6 / versionName=0.3.1（见 app/AndroidManifest.xml）。
# 部署到 Render 时把 APK_URL 换成你真实可下载的地址（推荐 GitHub Releases）。
# 注意这三项描述的是「**下一个**版本」：和客户端同号就等价于「已是最新」，
# 要发新版时把 CODE / NAME 一起 +1 并上传对应 Release。
APK_VERSION_CODE=6
APK_VERSION_NAME=0.3.1
APK_URL=https://github.com/yu10288201/dietdiary-server/releases/download/v0.3.1/shike-0.3.1.apk
APK_NOTES=修好「检查更新说拿不到数据清单」：兜底版本接口换成线上 /api/version，没登录也能查
APK_FORCE=false
# 低于这个 versionCode 的客户端会被提示「必须更新」
APK_MIN_SUPPORTED=1
