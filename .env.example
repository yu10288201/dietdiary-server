TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTIxNjc5MjYsImlkIjoiMDFhMTQ1ODctYTkwMS03MzQ2LWIxM2QtNzk5OTVhNjg3ZWJjIiwia2lkIjoiUVZSbTQySk42ZnhTNERzMk45R3loY09Gakd4NVlrajFXTzgwR1hOc3JpUSIsInJpZCI6IjczZDQxNTA2LTMzYWQtNDc5YS1hZWUyLTJhOWRlYzYyOWNkNCJ9.qSzXFmmT1_2PlhKvBN-v7_LP8ZTN-rbuFPLrZuxgPecmYgwAO2N58FixDpC96UVaoasTCUW38TT6EXQ5QS-QAA

# 本地开发不想连 Turso 时，把上面两行注释掉，会自动退化成
# 本地文件数据库 ./local.db（仅本机可用，Render 上请务必用 Turso）
# TURSO_DATABASE_URL=file:./local.db

# ===== 服务 =====
# Render 会自己注入 PORT，本地默认 3000
PORT=3000

# ===== 鉴权 =====
# 本服务不用 JWT 库：登录 token 是 crypto.randomBytes 随机串，存 sessions 表。
# JWT_SECRET 只作为 pepper 掺进 token 派生（见 src/auth.js 的 PEPPER），
# 「换掉它 = 所有旧 token 立即失效」，方便强制下线。请务必改成随机长字符串。
# 生成方法： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（天），过期后 token 失效，需要重新登录
SESSION_TTL_DAYS=90

# ===== 更新检查接口 GET /api/version 用 =====
# App 启动时会请求它，不需要鉴权
APK_VERSION_CODE=1
APK_VERSION_NAME=0.1.0
APK_URL=https://example.com/dietdiary-0.1.0.apk
APK_NOTES=首个内测版本
APK_FORCE=false
APK_MIN_SUPPORTED=1
