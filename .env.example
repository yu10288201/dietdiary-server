# ===== Turso（libSQL）=====
# 在 Turso CLI 里这样取：
#   turso db create dietdiary
#   turso db show dietdiary --url          -> 填到 TURSO_DATABASE_URL
#   turso db tokens create dietdiary       -> 填到 TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://<你的库名>-<你的用户名>.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=<把你的 token 填在这里，不要提交进仓库>

# 本地开发不想连 Turso 时，把上面两行注释掉，会自动退化成
# 本地文件数据库 ./local.db（仅本机可用，Render 上请务必用 Turso）
# TURSO_DATABASE_URL=file:./local.db

# ===== 服务 =====
# Render 会自己注入 PORT，本地默认 3000
PORT=3000

# ===== 鉴权 =====
# 本服务不用 JWT 库：登录 token 是 crypto.randomBytes 随机串，存 sessions 表。
# JWT_SECRET 只作为 pepper 掺进 token 派生（见 src/auth.js 的 PEPPER），
# 「换掉它 = 所有旧 token 立即失效」，方便强制下线。请务必改成随机长字符串。
# 生成方法： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（天），过期后 token 失效，需要重新登录
SESSION_TTL_DAYS=90

# ===== 更新检查接口 GET /api/version 用 =====
# App 启动时会请求它，不需要鉴权。
#
# 这几个值必须与「你真正上传的那个 APK」一致，否则：
#   填得比客户端低  -> 永远不提示更新
#   填得高但 URL 404 -> 用户点了「下载并安装」必然白下
# 客户端当前版本是 versionCode=6 / versionName=0.3.1（见 app/AndroidManifest.xml）。
# 部署到 Render 时把 APK_URL 换成你真实可下载的地址（推荐 GitHub Releases）。
# 注意这三项描述的是「**下一个**版本」：和客户端同号就等价于「已是最新」，
# 要发新版时把 CODE / NAME 一起 +1 并上传对应 Release。
APK_VERSION_CODE=6
APK_VERSION_NAME=0.3.1
APK_URL=https://github.com/yu10288201/dietdiary-server/releases/download/v0.3.1/shike-0.3.1.apk
APK_NOTES=修好「检查更新说拿不到数据清单」：兜底版本接口换成线上 /api/version，没登录也能查
APK_FORCE=false
# 低于这个 versionCode 的客户端会被提示「必须更新」
APK_MIN_SUPPORTED=1
