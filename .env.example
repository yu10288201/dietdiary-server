# ===== Turso（libSQL）=====
# 在 Turso CLI 里这样取：
#   turso db create dietdiary
#   turso db show dietdiary --url          -> 填到 TURSO_DATABASE_URL
#   turso db tokens create dietdiary       -> 填到 TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://dietdiary-yu10288201.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...把你的真实 token 粘这里...

# 本地开发不想连 Turso 时，把上面两行注释掉，会自动退化成
# 本地文件数据库 ./local.db（仅本机可用，Render 上请务必用 Turso）
# TURSO_DATABASE_URL=file:./local.db

# ===== 服务 =====
# Render 会自己注入 PORT，本地默认 3000
PORT=3000

# ===== 鉴权 =====
# 本服务不用 JWT 库：登录 token 是 crypto.randomBytes 随机串，存 sessions 表。
# JWT_SECRET 只作为 pepper 掺进 token 派生（见 src/auth.js 的 PEPPER），
# 「换掉它 = 所有旧 token 立即失效」，方便强制下线。请务必改成随机长字符串。
# 生成方法： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# 会话有效期（天），过期后 token 失效，需要重新登录
SESSION_TTL_DAYS=90

# ===== 更新检查接口 GET /api/version 用 =====
# App 启动时会请求它，不需要鉴权
APK_VERSION_CODE=1
APK_VERSION_NAME=0.1.0
APK_URL=https://example.com/dietdiary-0.1.0.apk
APK_NOTES=首个内测版本
APK_FORCE=false
APK_MIN_SUPPORTED=1

# ---------------------------------------------------------------- 饭菜照片（v0.7.3）
# 图片存阿里云 OSS，数据库里只留 object_key。四项缺任何一项就当「没配」，
# POST /api/photos 会回 503，识别和记录照常能用。
# 建议新建 RAM 子账号，只授权这一个 Bucket 的读写，别用主账号 AccessKey。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=shike-photos
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# 可选：自定义域名 / CDN 前缀。不填就用 https://<bucket>.<endpoint>
OSS_PUBLIC_BASE=
# 可选：设为 1 表示 Bucket 私有读，图片地址换成 1 小时到期的签名链接
OSS_PRIVATE=
# 可选：对象前缀，默认 photos/
OSS_PREFIX=photos/
# 可选：上传超时（毫秒）
OSS_TIMEOUT_MS=15000

# 每人每天最多传几张、单张上限、备注长度
PHOTO_DAILY_LIMIT=30
PHOTO_MAX_BYTES=3145728
